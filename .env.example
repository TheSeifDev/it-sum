# Server Configuration
PORT=8080
APP_ENV=development

# Database Configuration (PostgreSQL / Neon)
# Format: postgres://<user>:<password>@<neon-hostname>/<database>?sslmode=require
DATABASE_URL=postgres://neondb_owner:your_password_here@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Configuration
# Comma-separated list of allowed frontend origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000
